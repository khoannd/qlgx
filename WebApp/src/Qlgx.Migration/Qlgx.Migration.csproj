<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Qlgx.Migration.Core\Qlgx.Migration.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Day la project DUY NHAT trong solution duoc phep phu thuoc Windows/OleDb; logic chuyen
      doi thuc su nam o Qlgx.Migration.Core (net10.0, AnyCPU) de con test duoc tren moi may.

      KHONG ghim cung PlatformTarget. Driver Microsoft ACE OLEDB phai cung bitness voi tien
      trinh goi no, ma bitness cai dat lai khac nhau theo tung may: may dev nay chi co ACE
      64-bit, nhieu may giao xu chi co ACE 32-bit. Ghim cung x86 thi may chi co ACE 64-bit
      khong chay duoc, va nguoc lai. Vi vay chon bitness luc publish bang tham so RID
      "win-x86" hoac "win-x64", kem tuy chon self contained de khong bat nguoi dung phai cai
      san .NET dung bitness. Xem huong dan trong WebApp/src/Qlgx.Migration/README.md.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
