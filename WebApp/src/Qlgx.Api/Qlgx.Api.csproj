<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Qlgx.Data\Qlgx.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Xac thuc JWT (Task 14). PasswordHasher<T> (Microsoft.Extensions.Identity.Core) da co
         san qua Microsoft.NET.Sdk.Web nen khong can khai bao rieng. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.55.0" />
    <!-- Xử lý ảnh đại diện (Task 1.2 VIEC-TIEP-THEO.md): giải mã + kiểm chữ ký thật + thu nhỏ
         ảnh tải lên trước khi lưu vào CSDL. SkiaSharp — giấy phép MIT (tự do), có gói native
         cho Linux (image nền chạy Docker/Linux của Dockerfile là Debian glibc, không phải
         Alpine). KHÔNG dùng System.Drawing.Common — gói đó không chạy trên Linux từ .NET 7. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Mẫu in HTML (xem Printing/BoDoMauIn.cs) nhúng thẳng vào assembly thay vì để dạng tệp rời
       trên đĩa cạnh tệp thực thi — máy chủ chạy container (Dockerfile) không đảm bảo giữ đúng
       cấu trúc thư mục nguồn, còn nhúng vào assembly thì chắc chắn đi cùng bản build. -->
  <ItemGroup>
    <EmbeddedResource Include="PrintTemplates\**\*.html" />
  </ItemGroup>

</Project>
