# Sao chép tệp này thành ".env" (cùng thư mục, cạnh docker-compose.yml) rồi điền giá trị THẬT.
# ".env" KHÔNG được commit (đã có trong .gitignore) — tệp NÀY (.env.example) không chứa bất kỳ
# giá trị thật nào, chỉ liệt kê tên biến, an toàn để nằm trong git.

# --- PostgreSQL ---
POSTGRES_DB=qlgx
POSTGRES_USER=
POSTGRES_PASSWORD=

# Vai trò CSDL cho API nghiệp vụ (RLS-hạn chế, KHÔNG BYPASSRLS) — tạo bằng tay sau khi container
# postgres chạy lần đầu, xem TRIEN-KHAI.md mục "Row-Level Security".
QLGX_APP_DB_USER=
QLGX_APP_DB_PASSWORD=

# Vai trò CSDL có BYPASSRLS, chỉ dùng cho đăng nhập/tạo tài khoản quản trị/chuyển dữ liệu. Có
# thể để trống khi pilot một giáo xứ (API sẽ dùng lại QLGX_APP_DB_USER) nhưng PHẢI đặt khác
# trước khi có giáo xứ thứ hai.
QLGX_ADMIN_DB_USER=
QLGX_ADMIN_DB_PASSWORD=

# --- Qlgx.Api ---
# Cổng máy chủ (docker host) trỏ vào container API — reverse proxy/bộ cân bằng tải phía trước
# gọi vào cổng này (xem TRIEN-KHAI.md mục HTTPS).
QLGX_API_PORT=8080

# Khoá ký JWT — chuỗi base64 của ít nhất 32 byte ngẫu nhiên. Sinh bằng:
#   openssl rand -base64 32
# ĐỔI khoá này sẽ đăng xuất toàn bộ người dùng đang có phiên hoạt động (token cũ hết hiệu lực).
QLGX_JWT_KEY=

ASPNETCORE_ENVIRONMENT=Production
