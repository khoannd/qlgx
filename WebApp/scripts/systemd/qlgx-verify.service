[Unit]
Description=QLGX -- dien tap phuc hoi hang tuan
Documentation=https://github.com/khoannd/qlgx
After=docker.service
Requires=docker.service
ConditionPathExists=/opt/qlgx/WebApp/scripts/qlgx-runner.sh

[Service]
Type=oneshot
EnvironmentFile=/etc/qlgx/backup.env
# dien-tap nap ban sao vao mot CSDL RIENG (qlgx_dien_tap_<thoi diem>), kiem chung, roi xoa. No
# KHONG dong toi CSDL that. Khoa do qlgx-restore.sh tu gianh -- xem gianh_khoa_phuc_hoi.
# Goi qua "/bin/bash <script>" chu khong chay thang script: kho git phat trien tren Windows
# nen git ghi nhan cac tep .sh la 100644 (khong co bit thuc thi). install.sh co dat lai bit do
# (dat_bit_thuc_thi), nhung cach goi nay lam unit chay duoc ke ca khi ai do chep unit vao may
# bang tay ma bo qua buoc do.
ExecStart=/bin/bash /opt/qlgx/WebApp/scripts/qlgx-runner.sh dien-tap
TimeoutStartSec=7200
TimeoutStopSec=60
